    "check": "biome check --write",
    "ci": "biome ci"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "draftjs-to-html": "^0.9.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/draftjs-to-html": "^0.8.4",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  },
  "overrides": {
    "immutable": "^3.8.4"
  }
}
