{
  "name": "draft.js-json-previewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && gh-pages -d dist -u \"github-actions-bot <support+actions@github.com>\"",
